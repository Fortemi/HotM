# Fortemi API Configuration
# Copy this file to .env.local for local development

# API Base URL — include the versioned path prefix (default: http://localhost:3000/api/v1)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Alternative configurations:
# For remote Fortemi environment:
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# For production:
# VITE_API_BASE_URL=https://api.fortemi.example.com/api/v1

# Note: regular pushes touching ui/** trigger CI image build/publish to Gitea.

# =============================================================================
# Sentry Error Tracking (Issue #58)
# =============================================================================
# Sentry DSN for error tracking (obtain from https://sentry.io)
# Leave empty to disable error tracking
VITE_SENTRY_DSN=

# Example:
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Enable Sentry in development mode (default: false)
# Only set this if you want to send errors from dev environment
# VITE_SENTRY_DEV_ENABLED=true

# Application version for release tracking
# Auto-detected from package.json if not set
# VITE_APP_VERSION=0.1.2
