{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HotM",
  "version": "2026.5.8",
  "identifier": "com.hotm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "HotM - Hall of the Mind"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http: ws: wss:; img-src 'self' data: blob: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/hotm-matric-api"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (C) 2026 Joseph Magly. Licensed under BUSL-1.1.",
    "shortDescription": "Knowledge exploration and note-taking",
    "longDescription": "Hall of the Mind - A desktop application for note-taking, knowledge exploration, and analysis powered by the Fortemi API.",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "postgresql-18",
          "postgresql-contrib-18"
        ],
        "recommends": [
          "postgresql-18-pgvector",
          "postgresql-18-postgis-3"
        ],
        "section": "utils",
        "postInstallScript": "scripts/postinst.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
