{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HotM",
  "version": "0.1.0",
  "identifier": "com.hotm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:full",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hall of the Mind - Notes & Analysis",
        "width": 1200,
        "height": 800,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "skipTaskbar": false,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "en-US",
        "dialogImagePath": "../icons/icon.png",
        "bannerPath": "../icons/icon.png"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "../icons/icon.ico",
        "installMode": "perUser"
      },
      "allowDowngrades": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}