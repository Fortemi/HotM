{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HotM",
  "version": "0.1.0",
  "identifier": "com.hotm.app",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "title": "HotM", "width": 1200, "height": 800, "decorations": true }]
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": { "wix": { "enableElevatedUpdateTask": false } }
  }
}
