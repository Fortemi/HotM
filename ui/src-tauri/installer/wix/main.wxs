<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- HotM Installer - Server + Desktop Client -->
  <!-- Simplified: Server always installed, Desktop optional -->
  <!-- PostgreSQL: Docker-based setup with pgvector/pgvector:pg16 image -->

  <Fragment>
    <UI>
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
      <Property Id="ADD_TO_STARTUP" Value="1" />
      <Property Id="INSTALL_DESKTOP" Value="1" />
      <Property Id="SETUP_DATABASE" Value="1" />

      <!-- Single setup dialog -->
      <Dialog Id="SetupOptionsDlg" Width="370" Height="290" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Installation Options</Text>
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>Configure Hall of the Mind installation.</Text>
        </Control>

        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <!-- Server info -->
        <Control Id="ServerInfo" Type="Text" X="25" Y="55" Width="320" Height="25" Transparent="yes" NoPrefix="yes">
          <Text>The HotM API Server (port 53211) will be installed as a Windows Service.</Text>
        </Control>

        <!-- Database setup option -->
        <Control Id="DatabaseCheckBox" Type="CheckBox" X="25" Y="82" Width="300" Height="17"
                 Property="SETUP_DATABASE" CheckBoxValue="1">
          <Text>Setup PostgreSQL with pgvector (requires Docker)</Text>
        </Control>

        <Control Id="DatabaseInfo" Type="Text" X="35" Y="99" Width="310" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>Creates Docker container with PostgreSQL 16 + pgvector on port 5433.</Text>
        </Control>

        <!-- Desktop client option -->
        <Control Id="DesktopCheckBox" Type="CheckBox" X="25" Y="122" Width="300" Height="17"
                 Property="INSTALL_DESKTOP" CheckBoxValue="1">
          <Text>Install Desktop Client</Text>
        </Control>

        <Control Id="DesktopInfo" Type="Text" X="35" Y="139" Width="310" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>Rich desktop interface with global hotkey (Ctrl+Alt+H) and tray.</Text>
        </Control>

        <!-- Startup option -->
        <Control Id="StartupCheckBox" Type="CheckBox" X="35" Y="162" Width="280" Height="17"
                 Property="ADD_TO_STARTUP" CheckBoxValue="1">
          <Condition Action="enable">INSTALL_DESKTOP = "1"</Condition>
          <Condition Action="disable">INSTALL_DESKTOP &lt;&gt; "1"</Condition>
          <Text>Start with Windows (minimized to tray)</Text>
        </Control>

        <!-- Prerequisites note -->
        <Control Id="PrereqInfo" Type="Text" X="25" Y="190" Width="320" Height="40" Transparent="yes" NoPrefix="yes">
          <Text>Additional: Ollama with nomic-embed-text and gpt-oss:20b models for AI features.</Text>
        </Control>

        <Control Id="BottomLine" Type="Line" X="0" Y="254" Width="370" Height="0" />

        <Control Id="Back" Type="PushButton" X="180" Y="263" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>

        <Control Id="Next" Type="PushButton" X="236" Y="263" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>

        <Control Id="Cancel" Type="PushButton" X="304" Y="263" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="SetupOptionsDlg" After="InstallDirDlg" />
      </InstallUISequence>
    </UI>

    <!-- Directory structure -->
    <DirectoryRef Id="INSTALLDIR">
      <!-- Server binary - always installed -->
      <Component Id="ServerBinary" Guid="*">
        <File Id="HotmServer" Source="$(var.ResourcesPath)hotm-server.exe" KeyPath="yes" />

        <!-- Install Windows service for server -->
        <ServiceInstall Id="HotmServerService"
                       Type="ownProcess"
                       Name="HotmServer"
                       DisplayName="Hall of the Mind Server"
                       Description="HotM API server - local-first notes and NLP processing (port 53211)"
                       Start="auto"
                       Account="LocalSystem"
                       ErrorControl="normal"
                       Arguments="--service" />

        <ServiceControl Id="StartHotmServer"
                       Name="HotmServer"
                       Start="install"
                       Stop="both"
                       Remove="uninstall"
                       Wait="yes" />
      </Component>

      <!-- Server configuration -->
      <Component Id="ServerConfig" Guid="*">
        <RegistryValue Root="HKLM"
                       Key="Software\HotM\Server"
                       Name="Port"
                       Type="integer"
                       Value="53211"
                       KeyPath="yes"/>
        <RegistryValue Root="HKLM"
                       Key="Software\HotM\Server"
                       Name="DatabaseUrl"
                       Type="string"
                       Value="postgres://postgres:postgres@localhost:5433/hotm_dev"/>
      </Component>

      <!-- Schema initialization script -->
      <Component Id="SchemaScript" Guid="*">
        <File Id="CleanSchema" Source="$(var.ResourcesPath)clean-schema.sql" KeyPath="yes" />
      </Component>

      <!-- Database setup script (Docker-based) -->
      <Component Id="SetupScripts" Guid="*">
        <File Id="SetupPostgres" Source="$(var.ResourcesPath)setup-postgres.ps1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Custom action to run database setup -->
    <CustomAction Id="SetupDatabase"
                  Directory="INSTALLDIR"
                  ExeCommand="powershell.exe -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]setup-postgres.ps1&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="SetupDatabase" After="InstallFiles">
        SETUP_DATABASE = "1" AND NOT REMOVE
      </Custom>
    </InstallExecuteSequence>

    <!-- Desktop startup shortcut -->
    <DirectoryRef Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="*">
        <Condition>ADD_TO_STARTUP = "1" AND INSTALL_DESKTOP = "1"</Condition>

        <Shortcut Id="ApplicationStartupShortcut"
                  Name="Hall of the Mind"
                  Description="Hall of the Mind - Notes &amp; Analysis"
                  Target="[INSTALLDIR]hotm-ui.exe"
                  Arguments="--minimized"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon.exe"
                  IconIndex="0" />

        <RegistryValue Root="HKCU"
                       Key="Software\HotM\Startup"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Directory Id="StartupFolder" Name="Startup">
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Hall of the Mind"/>
      </Directory>
    </Directory>

    <!-- Features -->
    <Feature Id="CoreServer"
             Title="HotM Server"
             Description="API Server (always installed)"
             Level="1"
             Display="expand"
             Absent="disallow"
             ConfigurableDirectory="INSTALLDIR">
      <ComponentRef Id="ServerBinary" />
      <ComponentRef Id="ServerConfig" />
      <ComponentRef Id="SchemaScript" />
      <ComponentRef Id="SetupScripts" />
    </Feature>

    <Feature Id="DesktopFeature"
             Title="Desktop Client"
             Description="Rich desktop interface with hotkeys and tray integration"
             Level="1"
             Display="expand">
      <Condition Level="1">INSTALL_DESKTOP = "1"</Condition>
      <ComponentRef Id="StartupShortcut" />
    </Feature>
  </Fragment>
</Wix>