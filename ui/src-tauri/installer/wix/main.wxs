<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- This is a template file that Tauri will use as a base and inject required variables -->
  <!-- The Product, Package, and other elements will be auto-generated by Tauri -->
  
  <Fragment>
    <!-- Add custom dialogs for component selection and startup option -->
    <UI>
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
      <Property Id="ADD_TO_STARTUP" Value="1" />
      <Property Id="INSTALL_CLIENT" Value="1" />
      <Property Id="INSTALL_SERVER" Value="0" />
      
      <!-- Custom dialog for component selection -->
      <Dialog Id="ComponentsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Choose Components</Text>
        </Control>
        
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>Choose which components of Hall of the Mind to install.</Text>
        </Control>
        
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        
        <Control Id="ClientCheckBox" Type="CheckBox" X="25" Y="70" Width="300" Height="17" 
                 Property="INSTALL_CLIENT" CheckBoxValue="1">
          <Text>Desktop Client (Tauri UI) - Recommended</Text>
        </Control>
        
        <Control Id="ClientInfo" Type="Text" X="35" Y="85" Width="300" Height="25" Transparent="yes" NoPrefix="yes">
          <Text>Rich desktop interface with global hotkey (Ctrl+Alt+H) and tray integration.</Text>
        </Control>
        
        <Control Id="ServerCheckBox" Type="CheckBox" X="25" Y="115" Width="300" Height="17" 
                 Property="INSTALL_SERVER" CheckBoxValue="1">
          <Text>API Server (Rust backend) - Advanced</Text>
        </Control>
        
        <Control Id="ServerInfo" Type="Text" X="35" Y="130" Width="300" Height="40" Transparent="yes" NoPrefix="yes">
          <Text>Local HTTP API server (port 53211) for integrations, automation, and headless usage. Requires PostgreSQL database setup.</Text>
        </Control>
        
        <Control Id="RecommendedText" Type="Text" X="25" Y="175" Width="300" Height="25" Transparent="yes" NoPrefix="yes">
          <Text>💡 Most users should install the Desktop Client. The Server is for advanced integrations.</Text>
        </Control>
        
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="StartupDlg">INSTALL_CLIENT = "1"</Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg">INSTALL_CLIENT = "0"</Publish>
        </Control>
        
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      
      <!-- Custom dialog to ask about startup -->
      <Dialog Id="StartupDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Configure Startup</Text>
        </Control>
        
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>Choose whether Hall of the Mind should start automatically with Windows.</Text>
        </Control>
        
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        
        <Control Id="StartupCheckBox" Type="CheckBox" X="25" Y="80" Width="300" Height="17" 
                 Property="ADD_TO_STARTUP" CheckBoxValue="1">
          <Text>Start Hall of the Mind when Windows starts (minimized to tray)</Text>
        </Control>
        
        <Control Id="InfoText" Type="Text" X="35" Y="100" Width="300" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>When enabled, the app will start minimized in the system tray. Press Ctrl+Alt+H to show/hide the window.</Text>
        </Control>
        
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      
      <!-- Modify the install sequence to include our dialogs -->
      <InstallUISequence>
        <Show Dialog="ComponentsDlg" After="InstallDirDlg" />
        <Show Dialog="StartupDlg" After="ComponentsDlg">INSTALL_CLIENT = "1"</Show>
      </InstallUISequence>
    </UI>
    
    <!-- Server components -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="ServerBinary" Guid="*">
        <Condition>INSTALL_SERVER = "1"</Condition>
        <File Id="HotmServer" Source="$(var.ResourcesPath)hotm-server.exe" KeyPath="yes" />
        
        <!-- Install Windows service for server -->
        <ServiceInstall Id="HotmServerService"
                       Type="ownProcess"
                       Name="HotmServer"
                       DisplayName="Hall of the Mind Server"
                       Description="Local HTTP API server for Hall of the Mind integrations"
                       Start="auto"
                       Account="LocalSystem"
                       ErrorControl="normal"
                       Arguments="--service" />
        
        <ServiceControl Id="StartHotmServer"
                       Name="HotmServerService"
                       Start="install"
                       Stop="both"
                       Remove="uninstall" />
      </Component>
      
      <!-- Server configuration files -->
      <Component Id="ServerConfig" Guid="*">
        <Condition>INSTALL_SERVER = "1"</Condition>
        <File Id="ServerReadme" Source="$(var.ResourcesPath)SERVER_README.txt" />
        
        <!-- Create registry entry for server port -->
        <RegistryValue Root="HKLM" 
                       Key="Software\HotM\Server"
                       Name="Port" 
                       Type="integer" 
                       Value="53211" 
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    
    <!-- Create the startup shortcut if requested -->
    <DirectoryRef Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="*">
        <Condition>ADD_TO_STARTUP = "1" AND INSTALL_CLIENT = "1"</Condition>
        
        <Shortcut Id="ApplicationStartupShortcut"
                  Name="Hall of the Mind"
                  Description="Hall of the Mind - Notes &amp; Analysis"
                  Target="[INSTALLDIR]hotm-ui.exe"
                  Arguments="--minimized"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon.exe"
                  IconIndex="0" />
                  
        <RegistryValue Root="HKCU" 
                       Key="Software\HotM\Startup"
                       Name="installed" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    
    <!-- Add the startup folder to the directory structure -->
    <Directory Id="StartupFolder" Name="Startup">
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Hall of the Mind"/>
      </Directory>
    </Directory>
    
    <!-- Features for different installation options -->
    <Feature Id="ClientFeature" 
             Title="Desktop Client" 
             Description="Hall of the Mind desktop application with tray integration"
             Level="1"
             Display="expand"
             ConfigurableDirectory="INSTALLDIR">
      <Condition Level="1">INSTALL_CLIENT = "1"</Condition>
      <ComponentRef Id="StartupShortcut" />
    </Feature>
    
    <Feature Id="ServerFeature" 
             Title="API Server" 
             Description="Local HTTP API server for integrations and automation"
             Level="2"
             Display="expand">
      <Condition Level="1">INSTALL_SERVER = "1"</Condition>
      <ComponentRef Id="ServerBinary" />
      <ComponentRef Id="ServerConfig" />
    </Feature>
  </Fragment>
</Wix>