<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- This is a template file that Tauri will use as a base and inject required variables -->
  <!-- The Product, Package, and other elements will be auto-generated by Tauri -->
  
  <Fragment>
    <!-- Add custom dialog for startup option -->
    <UI>
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
      <Property Id="ADD_TO_STARTUP" Value="1" />
      
      <!-- Custom dialog to ask about startup -->
      <Dialog Id="StartupDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Configure Startup</Text>
        </Control>
        
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>Choose whether Hall of the Mind should start automatically with Windows.</Text>
        </Control>
        
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        
        <Control Id="StartupCheckBox" Type="CheckBox" X="25" Y="80" Width="300" Height="17" 
                 Property="ADD_TO_STARTUP" CheckBoxValue="1">
          <Text>Start Hall of the Mind when Windows starts (minimized to tray)</Text>
        </Control>
        
        <Control Id="InfoText" Type="Text" X="35" Y="100" Width="300" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>When enabled, the app will start minimized in the system tray. Press Ctrl+Alt+H to show/hide the window.</Text>
        </Control>
        
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      
      <!-- Modify the install sequence to include our dialog -->
      <InstallUISequence>
        <Show Dialog="StartupDlg" After="InstallDirDlg" />
      </InstallUISequence>
    </UI>
    
    <!-- Create the startup shortcut if requested -->
    <DirectoryRef Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="*">
        <Condition>ADD_TO_STARTUP = "1"</Condition>
        
        <Shortcut Id="ApplicationStartupShortcut"
                  Name="Hall of the Mind"
                  Description="Hall of the Mind - Notes &amp; Analysis"
                  Target="[INSTALLDIR]hotm-ui.exe"
                  Arguments="--minimized"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon.exe"
                  IconIndex="0" />
                  
        <RegistryValue Root="HKCU" 
                       Key="Software\HotM\Startup"
                       Name="installed" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    
    <!-- Add the startup folder to the directory structure -->
    <Directory Id="StartupFolder" Name="Startup">
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Hall of the Mind"/>
      </Directory>
    </Directory>
    
    <!-- Include the startup component in the main feature -->
    <Feature Id="MainFeature">
      <ComponentRef Id="StartupShortcut" />
    </Feature>
  </Fragment>
</Wix>