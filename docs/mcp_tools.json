{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HotM MCP Tools",
  "type": "object",
  "properties": {
    "create_note": {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "required": ["content"],
          "properties": {
            "content": {"type": "string"},
            "format": {"type": "string", "enum": ["plaintext", "markdown", "webclip"], "default": "markdown"},
            "source": {"type": "string", "enum": ["manual", "import", "clip", "api"], "default": "manual"}
          }
        },
        "output": {
          "type": "object",
          "properties": {"noteId": {"type": "string"}}
        }
      }
    },
    "get_note": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
        "output": {"type": "object", "properties": {"note": {"type": "object"}, "original": {"type": "object"}, "revised": {"type": "object"}, "tags": {"type": "array", "items": {"type": "string"}}, "links": {"type": "array", "items": {"type": "object"}}}}
      }
    },
    "revise_note": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "instructions": {"type": "string"}, "targetStyle": {"type": "string"}}},
        "output": {"type": "object", "properties": {"revisionId": {"type": "string"}, "revisedContent": {"type": "string"}}}
      }
    },
    "search_notes": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "mode": {"type": "string", "enum": ["hybrid", "fts", "vector"], "default": "hybrid"}, "filters": {"type": "string"}}},
        "output": {"type": "object", "properties": {"hits": {"type": "array", "items": {"type": "object"}}}}
      }
    },
    "get_provenance": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
        "output": {"type": "object", "properties": {"graph": {"type": "object"}}}
      }
    },
    "set_tags": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "add": {"type": "array", "items": {"type": "string"}}, "remove": {"type": "array", "items": {"type": "string"}}}},
        "output": {"type": "object", "properties": {"tags": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "set_collection": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["id", "collection"], "properties": {"id": {"type": "string"}, "collection": {"type": "string"}}},
        "output": {"type": "object", "properties": {"collectionId": {"type": "string"}}}
      }
    },
    "analytics_query": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}},
        "output": {"type": "object", "properties": {"result": {"type": "object"}}}
      }
    },
    "export_notes": {
      "type": "object",
      "properties": {
        "input": {"type": "object", "required": ["ids", "format"], "properties": {"ids": {"type": "array", "items": {"type": "string"}}, "format": {"type": "string", "enum": ["zip", "jsonl"]}}},
        "output": {"type": "object", "properties": {"archivePath": {"type": "string"}}}
      }
    },
    "health_check": {
      "type": "object",
      "properties": {
        "input": {"type": "object"},
        "output": {"type": "object", "properties": {"ok": {"type": "boolean"}, "ollama": {"type": "boolean"}, "indexStatus": {"type": "object"}}}
      }
    }
  },
  "required": []
}
