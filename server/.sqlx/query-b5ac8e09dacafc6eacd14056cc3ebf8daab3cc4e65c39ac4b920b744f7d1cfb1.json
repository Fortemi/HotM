{
  "db_name": "PostgreSQL",
  "query": "SELECT \n            l.id, \n            l.from_note_id, \n            l.to_note_id, \n            l.to_url, \n            l.kind, \n            l.score, \n            l.created_at_utc,\n            l.metadata,\n            COALESCE(\n                substring(nrc.content from 1 for 100),\n                'Linked note'\n            ) as snippet\n        FROM link l\n        LEFT JOIN note_revised_current nrc ON nrc.note_id = l.to_note_id\n        WHERE l.from_note_id = $1\n        ORDER BY l.score DESC, l.created_at_utc DESC",
