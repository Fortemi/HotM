# HotM UI — environment configuration
#
# Only one variable is read by the React UI itself: VITE_API_BASE_URL. Everything
# else below configures the Fortemi backend (a separate process / container) and
# is included here only because the install scripts source this file.
#
# Copy to .env and edit.

# ── HotM UI (read by the React app via Vite) ────────────────────────────────
# Fortemi API base URL. The UI talks to whatever Fortemi instance you point
# it at — local sidecar, separate Docker container, or remote server.
VITE_API_BASE_URL=http://localhost:3000

# ── Fortemi backend configuration (NOT read by the HotM UI) ─────────────────
# These belong on the Fortemi side. Documented here for the desktop installer
# convenience only. If you're running Fortemi separately, configure these in
# Fortemi's own .env or inference.toml — changes here will not affect a
# separately-running Fortemi.
#
# See: https://git.integrolabs.net/Fortemi/fortemi#configuration

# PostgreSQL/DocumentDB connection string (Fortemi reads this)
DATABASE_URL=postgres://user:pass@localhost:5432/hotm_dev

# Inference backend (Fortemi reads these). Fortemi is configurable for any
# OpenAI-compatible endpoint — set MATRIC_INFERENCE_DEFAULT to llamacpp,
# openai, or vllm if you're not using Ollama.
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GEN_MODEL=gpt-oss:20b
